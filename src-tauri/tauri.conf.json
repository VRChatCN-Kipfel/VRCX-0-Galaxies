{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "VRCX-0",
    "version": "2.33.0",
    "identifier": "com.vrcx-0.app",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:9000",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "withGlobalTauri": false,
        "security": {
            "csp": {
                "img-src": [
                    "'self'",
                    "https:",
                    "http://localhost:*",
                    "http://vrcx-0-img.localhost",
                    "http://vrcx-0-thumb.localhost",
                    "http://vrcx-0-bg-img.localhost",
                    "asset:",
                    "vrcx-0-img:",
                    "vrcx-0-thumb:",
                    "vrcx-0-bg-img:",
                    "data:",
                    "blob:"
                ],
                "worker-src": ["'self'", "blob:"]
            }
        },
        "windows": [
            {
                "label": "main",
                "create": false,
                "title": "VRCX-0",
                "width": 1024,
                "height": 768,
                "minWidth": 320,
                "minHeight": 240,
                "center": true,
                "decorations": false,
                "resizable": true
            }
        ],
        "trayIcon": {
            "id": "main",
            "iconPath": "icons/icon.png",
            "tooltip": "VRCX-0"
        }
    },
    "bundle": {
        "active": true,
        "licenseFile": "DISCLAIMER.txt",
        "resources": {
            "../LICENSE": "LICENSE",
            "../LICENSES/MIT.txt": "LICENSES/MIT.txt",
            "resources/licenses/THIRD_PARTY_NOTICES.txt": "licenses/THIRD_PARTY_NOTICES.txt"
        },
        "targets": ["nsis"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "digestAlgorithm": "sha256",
            "timestampUrl": "http://timestamp.acs.microsoft.com",
            "nsis": {
                "installerIcon": "icons/icon.ico",
                "displayLanguageSelector": false,
                "installMode": "currentUser"
            }
        },
        "createUpdaterArtifacts": true
    },
    "plugins": {
        "deep-link": {
            "desktop": {
                "schemes": ["vrcx-0"]
            }
        },
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFRjIwQkYzREMxMzgzQjAKUldTd2d4UGM4d3Z5N3MvNjk3RmZRU1JsQjNuZ1lPT2pkdnozUEhyWmRIWHZDOWR0TXhQS1A5VjkK",
            "endpoints": [
                "https://github.com/VRChatCN-Kipfel/VRCX-0-Galaxies/releases/latest/download/latest_linux_and_macos.json",
                "https://github.com/VRChatCN-Kipfel/VRCX-0-Galaxies/releases/latest/download/latest_windows.json"
            ],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
